ADAPTIVE_AUDIO_PLAYER_SESSION_SECRET=replace-with-a-long-random-secret
ADAPTIVE_AUDIO_PLAYER_DB_PATH=./data/adaptive-audio-player.sqlite
ADAPTIVE_AUDIO_PLAYER_DATA_ROOT=./data

# Local-only TTS sidecar used by the generation worker.
ADAPTIVE_AUDIO_PLAYER_TTS_URL=http://127.0.0.1:8765
ADAPTIVE_AUDIO_PLAYER_TTS_TIMEOUT_MS=180000
ADAPTIVE_AUDIO_PLAYER_TTS_DEVICE=cpu
ADAPTIVE_AUDIO_PLAYER_TTS_OFFLINE=false

# Optional: select a ready Python 3.12 interpreter. The launcher otherwise checks
# the active venv, data/local-tts/.venv, .venv, then Python on PATH.
ADAPTIVE_AUDIO_PLAYER_PYTHON=

# Optional High Quality setup uses a separate Python 3.11 runtime. Run
# `pnpm chatterbox:install` explicitly; normal startup never downloads it.
# The dev supervisor owns its ephemeral loopback URL and per-launch secret.
ADAPTIVE_AUDIO_PLAYER_CHATTERBOX_PYTHON=

# Optional: bound development health checks and coordinated child shutdown.
ADAPTIVE_AUDIO_PLAYER_DEV_HEALTH_TIMEOUT_MS=30000
ADAPTIVE_AUDIO_PLAYER_DEV_SHUTDOWN_TIMEOUT_MS=5000

# Optional: tune local worker behavior during development.
ADAPTIVE_AUDIO_PLAYER_WORKER_POLL_MS=150
ADAPTIVE_AUDIO_PLAYER_SAMPLE_JOB_DURATION_MS=350
ADAPTIVE_AUDIO_PLAYER_FULL_BOOK_JOB_DURATION_MS=550
