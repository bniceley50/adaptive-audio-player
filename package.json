{
  "name": "adaptive-audio-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-with-worker.mjs",
    "dev:app": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:all": "node scripts/dev-with-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "chatterbox:install": "node scripts/install-chatterbox.mjs",
    "worker": "node scripts/job-worker.mjs",
    "gate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.31",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "electron": "43.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
